# 打卡收集器設定範本：複製成 .env 後填入 COLLECTOR_KEY
# .env 含金鑰，不可 commit（已在 .gitignore）

# 卡機 IP，多台以逗號分隔
DEVICE_HOSTS=192.168.230.190,192.168.230.191
# 卡機連接埠
DEVICE_PORT=4370
# 卡機通訊密碼；現場確認沒有設定，填 0
DEVICE_COMM_KEY=0
# 單一指令逾時秒數
DEVICE_TIMEOUT_SECONDS=10
# 卡機支援 TCP，維持 false
DEVICE_FORCE_UDP=false
# 卡機姓名的文字編碼；現場確認是 Big5（cp950）
DEVICE_ENCODING=cp950
# 下載時是否停用卡機；停用期間員工無法打卡，維持 false
DISABLE_DEVICE_DURING_READ=false

# 輪詢間隔（秒）
POLL_INTERVAL_SECONDS=300
# 每日對帳時間（台北時間，HH:MM）
RECONCILE_TIME=03:30
# 對帳時重送最近幾天的紀錄
RECONCILE_DAYS=7

# 上傳網址（正式環境）
INGEST_URL=https://zakixjdjnwetrvhsqsyg.supabase.co/functions/v1/ingest-punches
# 指定 Edge Function 在東京執行；設成空值就不指定（本機測試時請留空）
INGEST_REGION=ap-northeast-1
# 上傳專用金鑰（必填），要和雲端 Edge Function secret COLLECTOR_KEY 相同
COLLECTOR_KEY=
# 每批上傳筆數
UPLOAD_BATCH_SIZE=500

# 卡機時鐘誤差超過幾秒時記警告
CLOCK_DRIFT_WARN_SECONDS=120
# 同一台卡機連續失敗幾次後改記 error
FAILURE_ERROR_THRESHOLD=6
# log 等級：DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO
