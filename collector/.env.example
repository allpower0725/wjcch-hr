# collector 共用設定範本；複製為同目錄的 .env，依用途設定 COLLECTOR_MODE。
# .env 含金鑰，不可 commit（已在 .gitignore）

# 卡機 IP，多台以逗號分隔
DEVICE_HOSTS=192.168.230.190,192.168.230.191
# 卡機連接埠
DEVICE_PORT=4370
# 卡機通訊密碼；現場確認沒有設定，填 0
DEVICE_COMM_KEY=0
# 單一指令逾時秒數
DEVICE_TIMEOUT_SECONDS=10
# 卡機支援 TCP，維持 false
DEVICE_FORCE_UDP=false
# 卡機姓名的文字編碼；現場確認是 Big5（cp950）
DEVICE_ENCODING=cp950
# 下載時是否停用卡機；停用期間員工無法打卡，維持 false
DISABLE_DEVICE_DURING_READ=false

# 輪詢間隔（秒）
POLL_INTERVAL_SECONDS=300
# 每日對帳時間（台北時間，HH:MM）
RECONCILE_TIME=03:30
# 對帳時重送最近幾天的紀錄
RECONCILE_DAYS=7

# test 使用 docker-compose.test.yml；production 使用 docker-compose.yml。
# 每次只連其中一個目的地，另一組連線設定不會使用。
COLLECTOR_MODE=test
LOCAL_DB_HOST=wjcch
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=wjcch_db
LOCAL_DB_USER=hr_collector
LOCAL_DB_PASSWORD_FILE=/run/secrets/collector_database_password
LOCAL_DB_SSLMODE=disable
# 正式主機從 Supabase Connect 面板核對；此處為 wjcch 的 session pooler。
CLOUD_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
CLOUD_DB_PORT=5432
CLOUD_DB_NAME=postgres
CLOUD_DB_USER=hr_collector.tbulauezaixdjzdcqsem
CLOUD_DB_PASSWORD_FILE=/run/secrets/collector_database_password
CLOUD_DB_SSLMODE=verify-full
CLOUD_DB_SSLROOTCERT=/run/certs/supabase-ca.crt
DB_TIMEOUT_SECONDS=15
# 每批上傳筆數
UPLOAD_BATCH_SIZE=500

# 卡機時鐘誤差超過幾秒時記警告
CLOCK_DRIFT_WARN_SECONDS=120
# 同一台卡機連續失敗幾次後改記 error
FAILURE_ERROR_THRESHOLD=6
# log 等級：DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO
